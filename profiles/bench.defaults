# First power-up / props-off bench testing: low throttle ceiling, drone boots disarmed.
CONFIG_MOTOR_THRUST_MAX=300
CONFIG_ESPNOW_CTRL_THRUST_MAX=300
CONFIG_ESPNOW_CTRL_START_DISARMED=y
CONFIG_ESPNOW_CTRL_FAILSAFE_DISARM=y
# No range finder on the bench: fewer parts in the first power-up
CONFIG_RANGE_VL53L0X_ENABLE=n
